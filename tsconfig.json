{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"types": [
			"node",
			"vscode"
		],
		"sourceMap": false,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"rootDir": "./src",
		"outDir": "./out"
	},
	"include": [
		"src/**/*"
	]
}